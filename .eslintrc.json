{
  "extends": "athom/homey-app",
  "ignorePatterns": ["test/", ".homeybuild/", "node_modules/"],
  "rules": {
    "node/no-missing-import": ["error", { "allowModules": ["homey"], "tryExtensions": [".js", ".ts", ".json", ".node"] }],
    "import/extensions": ["error", "ignorePackages", { "js": "never", "ts": "never" }]
  },
  "settings": {
    "import/resolver": { "node": { "extensions": [".js", ".ts", ".json", ".node"] } }
  },
  "overrides": [
    {
      // Homey SDK v3 requires `import Homey from 'homey'` + `module.exports =
      // class extends Homey.X` (see task/lessons.md), which this rule forbids.
      "files": ["app.ts", "drivers/**/*.ts"],
      "rules": {
        "import/no-import-module-exports": "off"
      }
    },
    {
      "files": ["lib/**/*.ts", "test/**/*.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    }
  ]
}
